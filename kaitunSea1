local function stopCurrentTween()
    if currentTween then
        currentTween:Cancel()
        currentTween:Destroy()
        currentTween = nil
    end
end

local function tweenTo(rootPart, targetPos)
    local distance = (rootPart.Position - targetPos).Magnitude
    if distance < 3 then 
        stopCurrentTween()
        return 
    end 

    if currentTween and currentTween.PlaybackState == Enum.PlaybackState.Playing then
        if (targetPos - lastTargetPos).Magnitude < 3 then
            return 
        end
    end

    stopCurrentTween() 
    lastTargetPos = targetPos

    local duration = distance / TWEEN_SPEED
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    local targetCFrame = CFrame.new(targetPos) * (rootPart.CFrame - rootPart.Position)
    
    pcall(function()
        rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end)
    
    currentTween = TweenService:Create(rootPart, tweenInfo, {CFrame = targetCFrame})
    currentTween:Play()
end

local function safeTeleportToGate(rootPart, gatePos3D, gateVector)
    stopCurrentTween() 
    task.wait(0.2)      
    
    if CommF then
        pcall(function()
            CommF:InvokeServer("requestEntrance", gateVector)
        end)
    end
    task.wait(0.2) 
    
    rootPart.CFrame = CFrame.new(gatePos3D)
    task.wait(0.4) 
end

local function hasActiveQuest()
    local playerGui = localPlayer:FindFirstChildOfClass("PlayerGui")
    local mainGui = playerGui and playerGui:FindFirstChild("Main")
    local questFrame = mainGui and mainGui:FindFirstChild("Quest")
    return questFrame and questFrame.Visible == true
end

local function getAliveTargetMob(mobName)
    for _, enemy in pairs(enemiesFolder:GetChildren()) do
        if enemy.Name == mobName then
            local humanoid = enemy:FindFirstChildOfClass("Humanoid")
            local rootPart = enemy:FindFirstChild("HumanoidRootPart") or enemy.PrimaryPart
            
            if humanoid and humanoid.Health > 0 and rootPart then
                return rootPart, humanoid 
            end
        end
    end
    return nil, nil
end

local function getBringTargetPosition()
    local myChar = localPlayer.Character or charactersFolder:FindFirstChild(localPlayer.Name)
    if myChar then
        local hrp = myChar:FindFirstChild("HumanoidRootPart")
        if hrp then
            return hrp.Position + Vector3.new(0, -20, 0)
        end
    end
    return nil
end

local function ApplyNoclipFull(enemy)
    if enemy then
        for _, child in pairs(enemy:GetDescendants()) do
            if child:IsA("BasePart") then
                child.CanCollide = false
            end
        end
    end
end

local function SetupMob(enemy)
    if enemy:GetAttribute("BusoEnabled") ~= nil then enemy:SetAttribute("BusoEnabled", false) end
    enemy:SetAttribute("Clashable", true) 
    
    local hrp = enemy:FindFirstChild("HumanoidRootPart")
    local humanoid = enemy:FindFirstChildOfClass("Humanoid")
    
    if hrp and hrp:IsA("BasePart") then
        if humanoid then
            humanoid.Sit = true
            humanoid.PlatformStand = true
        end
        pcall(function()
            if hrp.Anchored then hrp.Anchored = false end
            if hrp.SetNetworkOwner then hrp:SetNetworkOwner(localPlayer) end
        end)
        ApplyNoclipFull(enemy)

        local bp = hrp:FindFirstChild("BringMob") or Instance.new("BodyPosition")
        bp.Name = "BringMob"
        bp.MaxForce = Vector3.new(10000000, 10000000, 10000000)
        bp.P = 30000; bp.D = 1200;
        bp.Parent = hrp
        return bp
    end
    return nil
end

