-- [VÒNG LẶP GOM QUÁI]: BRING MOBS LOOP
-- =========================================================================
task.spawn(function()
    while true do
        local targetPos = getBringTargetPosition()
        local _, _, mobName, _, _ = getCurrentIslandConfig()
        
        if targetPos and hasActiveQuest() and mobName and mobName ~= "" then 
            local myActualPos = targetPos + Vector3.new(0, 20, 0)
            
            for _, enemy in pairs(enemiesFolder:GetChildren()) do
                if enemy.Name == mobName then
                    local hrp = enemy:FindFirstChild("HumanoidRootPart")
                    local humanoid = enemy:FindFirstChildOfClass("Humanoid")
                    
                    if hrp then
                        local bp = hrp:FindFirstChild("BringMob")
                        if not bp then bp = SetupMob(enemy) end
                        
                        local distance = (hrp.Position - myActualPos).Magnitude
                        
                        enemy:SetAttribute("Clashable", true)
                        enemy:SetAttribute("BusoEnabled", false)
                        if humanoid then
                            if not humanoid.Sit then humanoid.Sit = true end
                            if not humanoid.PlatformStand then humanoid.PlatformStand = true end
                        end
                        
                        if bp then
                            if distance <= MAX_DISTANCE_BRING then
                                bp.MaxForce = Vector3.new(10000000, 10000000, 10000000)
                                if distance <= MAX_DISTANCE_W then
                                    bp.P = 8000; bp.D = 800;
                                else
                                    bp.P = 40000; bp.D = 1500;
                                end
                                bp.Position = targetPos
                            else
                                bp.MaxForce = Vector3.new(0, 0, 0)
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.15)
    end
end)

enemiesFolder.ChildAdded:Connect(function(newEnemy)
    task.wait(0.05)
    local targetPos = getBringTargetPosition()
    local _, _, mobName, _, _ = getCurrentIslandConfig()
    
    if targetPos and hasActiveQuest() and mobName and mobName ~= "" and newEnemy.Name == mobName then
        local hrp = newEnemy:FindFirstChild("HumanoidRootPart")
        if hrp then
            local myActualPos = targetPos + Vector3.new(0, 20, 0)
            local distance = (hrp.Position - myActualPos).Magnitude
            if distance <= MAX_DISTANCE_BRING then SetupMob(newEnemy) end
        end
    end
end)
