-- [VÒNG LẶP CHÍNH]: ĐIỀU HƯỚNG DI CHUYỂN TOÀN MAP
-- =========================================================================
task.spawn(function()
    while task.wait(0.15) do 
        local Character = localPlayer.Character
        local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
        if not RootPart then continue end 

        local currentQuestName, currentQuestNum, mobName, defaultTargetPos, gateVector = getCurrentIslandConfig()
        if not currentQuestName or currentQuestName == "" then continue end

        -- Kiểm tra nhận Q
        if not hasActiveQuest() then
            stopCurrentTween()
            if CommF then
                pcall(function()
                    CommF:InvokeServer("StartQuest", currentQuestName, currentQuestNum)
                end)
            end
            task.wait(0.3)
            continue
        end

        local EnemyRoot, EnemyHumanoid = getAliveTargetMob(mobName)
        local viTriDich = defaultTargetPos
        
        if EnemyRoot and EnemyHumanoid then 
            viTriDich = Vector3.new(EnemyRoot.Position.X, EnemyRoot.Position.Y + Player_Y, EnemyRoot.Position.Z)
        else
            viTriDich = Vector3.new(defaultTargetPos.X, defaultTargetPos.Y + Player_Y, defaultTargetPos.Z)
        end

        -- [✓ LOGIC FISH ULTRA CLEAN]: Check thẳng bằng gateVector luôn, không cần biến chữ trung gian
        if gateVector == Fish_Vector3 and RootPart.Position.X < 50000 then
            stopCurrentTween()
            if CommF then
                pcall(function()
                    CommF:InvokeServer("requestEntrance", Fish_Vector3)
                end)
            end
            task.wait(0.8) 
            continue
        end

        if gateVector then
            local gatePos3D = toVector3(gateVector)
            
            local distance_HRP_to_Map = (RootPart.Position - viTriDich).Magnitude
            local distance_Gate_to_Map = (gatePos3D - viTriDich).Magnitude
            local distance_HRP_to_Gate = (RootPart.Position - gatePos3D).Magnitude

            if distance_HRP_to_Gate <= 300 then
                if distance_HRP_to_Map > 4 then
                    tweenTo(RootPart, viTriDich)
                else
                    stopCurrentTween()
                end
            elseif distance_Gate_to_Map < distance_HRP_to_Map then
                safeTeleportToGate(RootPart, gatePos3D, gateVector)
            else
                if distance_HRP_to_Map > 4 then
                    tweenTo(RootPart, viTriDich)
                else
                    stopCurrentTween()
                end
            end
        else
            -- Đảo thường (gateVector == nil): Chỉ sử dụng Tween thẳng, an toàn tuyệt đối
            local distanceToTarget = (RootPart.Position - viTriDich).Magnitude
            if distanceToTarget > 4 then
                tweenTo(RootPart, viTriDich)
            else
                stopCurrentTween()
            end
        end
    end
end)

