local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local configTeam = getgenv().Config and getgenv().Config["Join-to-Team"]
local targetTeam = (configTeam == "Pirates") and "Pirates" or "Marines"

local currentTeam = LocalPlayer.Team and LocalPlayer.Team.Name or ""

if currentTeam ~= targetTeam then 
    local remotes = ReplicatedStorage:WaitForChild("Remotes")
    local commF = remotes and remotes:WaitForChild("CommF_")
    if commF then
        commF:InvokeServer("SetTeam2", targetTeam)
    end
end

if SeaW == "Sea1" or SeaW == "Sea2" or SeaW == "Sea3" then
    pcall(function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/Ha3kCodeVN/by-FireSnowFireVoinDark/refs/heads/main/" .. SeaW))()
    end)
end

local function getMyCharacter()
    local charactersFolder = Workspace:FindFirstChild("Characters")
    if charactersFolder then
        return charactersFolder:FindFirstChild(LocalPlayer.Name)
    end
    return LocalPlayer.Character
end

local function isBusoOn()
    local myChar = getMyCharacter()
    if myChar and myChar:FindFirstChild("HasBuso", false) then
        return true
    end
    return false
end

task.spawn(function()
    while true do
        if not isBusoOn() then
            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            local commF = remotes and remotes:FindFirstChild("CommF_")
            if commF then
                commF:InvokeServer("Buso")
            end
        end
        task.wait(1)
    end
end)

RunService.Stepped:Connect(function()
    local character = getMyCharacter()
    if character then
        for _, child in ipairs(character:GetDescendants()) do
            if child:IsA("BasePart") then
                child.CanCollide = false
            end
        end
    end
end)

while true do
    local character = getMyCharacter()
    if character then
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local bodyVelocity = hrp:FindFirstChild("BodyCilp")
            if not bodyVelocity then
                bodyVelocity = Instance.new("BodyVelocity")
                bodyVelocity.Name = "BodyCilp"
                bodyVelocity.MaxForce = Vector3.new(10000, 10000, 10000) 
                bodyVelocity.Velocity = Vector3.new(0, 0, 0)
                bodyVelocity.Parent = hrp
            end
        end
    end
    task.wait(0.1)
end

