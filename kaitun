local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local SeaW = workspace:GetAttribute("Sea")

local targetTeam = "Pirates"
if getgenv().Config["Join-to-Team"].MARINES then
    targetTeam = "Marines"
elseif getgenv().Config["Join-to-Team"].PIRATES then
    targetTeam = "Pirates"
end

local currentTeam = LocalPlayer.Team and LocalPlayer.Team.Name or ""

if currentTeam ~= targetTeam then 
    local args = {
        "SetTeam",
        targetTeam
    }
    local remotes = game:GetService("ReplicatedStorage"):WaitForChild("Remotes", 1)
    if remotes then
        local commF = remotes:WaitForChild("CommF_", 1)
        if commF then
            commF:InvokeServer(unpack(args))
        end
    end
end

if SeaW == "Sea1" or SeaW == "Sea2" or SeaW == "Sea3" then
    loadstring(game:HttpGet("https://raw.githubusercontent.com/Ha3kCodeVN/by-FireSnowFireVoinDark/refs/heads/main/" .. SeaW))()
end
