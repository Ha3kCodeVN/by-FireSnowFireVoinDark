local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local targetTeam = "Pirates"
if getgenv().Config["Join-to-Team"].MARINES then
    targetTeam = "Marines"
elseif getgenv().Config["Join-to-Team"].PIRATES then
    targetTeam = "Pirates"
end

local currentTeam = LocalPlayer.Team and LocalPlayer.Team.Name or ""

if currentTeam == targetTeam then 
    return 
end

local args = {
    "SetTeam",
    targetTeam
}

local remotes = game:GetService("ReplicatedStorage"):WaitForChild("Remotes", 1)
if remotes then
    local commF = remotes:WaitForChild("CommF_", 1)
    if commF then
        commF:InvokeServer(unpack(args))
    end
end
