local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer

local TARGET_POSITION = Vector3.new(-4955.32080078125, 294.3970031738281, -2900.992919921875)
local MAX_DISTANCE_Teleport_SkipLevel = 1750
local TWEEN_SPEED = 350
local Player_Y = 20 

local currentTween = nil 

local function stopCurrentTween()
    if currentTween then
        currentTween:Cancel()
        currentTween:Destroy()
        currentTween = nil
    end
end

local function tweenTo(rootPart, targetPos)
    local distance = (rootPart.Position - targetPos).Magnitude
    if distance < 3 then return end 

    stopCurrentTween() 

    local duration = distance / TWEEN_SPEED
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    
    currentTween = TweenService:Create(rootPart, tweenInfo, {CFrame = CFrame.new(targetPos)})
    currentTween:Play()
end

local function getAliveSkyBandit()
    local Enemies = workspace:FindFirstChild("Enemies")
    if not Enemies then return nil, nil end
    
    for _, enemy in pairs(Enemies:GetChildren()) do
        if enemy.Name == "Sky Bandit" then
            local humanoid = enemy:FindFirstChildOfClass("Humanoid")
            local rootPart = enemy:FindFirstChild("HumanoidRootPart") or enemy.PrimaryPart
            
            if humanoid and humanoid.Health > 0 and rootPart then
                return rootPart, humanoid
            end
        end
    end
    
    return nil, nil
end

while task.wait(0.3) do
    local Character = LocalPlayer.Character
    local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
    if not RootPart then continue end

    local EnemyRoot, EnemyHumanoid = getAliveSkyBandit()
    local viTriDich = TARGET_POSITION
    
    if EnemyRoot and EnemyHumanoid then 
        viTriDich = Vector3.new(EnemyRoot.Position.X, EnemyRoot.Position.Y + Player_Y, EnemyRoot.Position.Z)
    else
        viTriDich = Vector3.new(TARGET_POSITION.X, TARGET_POSITION.Y + Player_Y, TARGET_POSITION.Z)
    end
    
    local Map = workspace:FindFirstChild("Map")
    local SkyArea1 = Map and Map:FindFirstChild("SkyArea1")
    local PathwayTemple = SkyArea1 and SkyArea1:FindFirstChild("PathwayTemple")
    
    if PathwayTemple then
        local TeleportPart = PathwayTemple:FindFirstChild("ExitPoint") or PathwayTemple:FindFirstChild("Entrance")
        
        if TeleportPart and TeleportPart:IsA("BasePart") then
            local distanceToExit = (RootPart.Position - TeleportPart.Position).Magnitude
            
            if distanceToExit > MAX_DISTANCE_Teleport_SkipLevel then
                stopCurrentTween() 

                for i = 1, 3 do
                    RootPart.CFrame = TeleportPart.CFrame
                    task.wait(0.1) 
                end
                
                local EntrancePart = PathwayTemple:FindFirstChild("Entrance")
                if EntrancePart then
                    EntrancePart:Destroy()
                end
                
                tweenTo(RootPart, viTriDich)
            else
                local distanceToTarget = (RootPart.Position - viTriDich).Magnitude
                if distanceToTarget > 5 then
                    if not currentTween or (currentTween.PlaybackState ~= Enum.PlaybackState.Playing) then
                        tweenTo(RootPart, viTriDich)
                    end
                end
            end
        end
    end
end
